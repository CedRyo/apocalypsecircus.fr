---
import { getCollection } from 'astro:content';

const sections = await getCollection('sections');
const sorted = sections.sort((a, b) => a.data.sectionNumber - b.data.sectionNumber);
---

<details class="sommaire relative">
  <summary class="text-sm tracking-widest uppercase cursor-pointer select-none opacity-60 hover:opacity-100 transition-opacity">
    Sommaire
  </summary>
  <div class="sommaire-panel absolute right-0 top-full mt-2 z-50 min-w-56 py-4 px-5"
       style="background-color: var(--bg); border: 1px solid var(--border); box-shadow: 0 8px 32px rgba(0,0,0,0.08);">
    <nav class="flex flex-col gap-1">
      <a href="/" class="text-sm py-1 opacity-60 hover:opacity-100 transition-opacity tracking-wide">
        — Accueil
      </a>
      {sorted.map((section) => (
        <a
          href={`/${section.id}`}
          class="text-sm py-1 opacity-80 hover:opacity-100 transition-opacity"
        >
          {section.data.title}
        </a>
      ))}
      <div style="border-top: 1px solid var(--border);" class="mt-2 pt-2">
        <a href="/a-propos" class="text-sm py-1 opacity-60 hover:opacity-100 transition-opacity tracking-wide">
          — À propos
        </a>
      </div>
    </nav>
  </div>
</details>
