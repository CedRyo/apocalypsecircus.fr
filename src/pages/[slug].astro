---
import { getCollection, render } from 'astro:content';
import SectionLayout from '../layouts/SectionLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('sections');
  const sorted = entries.sort((a, b) => a.data.sectionNumber - b.data.sectionNumber);

  return sorted.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: index > 0
        ? { id: sorted[index - 1].id, title: sorted[index - 1].data.title }
        : null,
      next: index < sorted.length - 1
        ? { id: sorted[index + 1].id, title: sorted[index + 1].data.title }
        : null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<SectionLayout
  title={entry.data.title}
  description={entry.data.description}
  sectionNumber={entry.data.sectionNumber}
  prev={prev}
  next={next}
>
  <Content />
</SectionLayout>
